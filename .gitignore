# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# sequence outputs and their resumable segments (default location is the program directory)
*.mp4
*.mp4.part
*.segments/

# Generated from docs/使用说明.md by tools/manual_pdf.py, and staged into dist/ by the
# release build. Not committed: a checked-in PDF is one that can be a release behind the
# Markdown it was made from, and nothing here reads it that the Markdown cannot serve.
docs/*.pdf
docs/*.html
